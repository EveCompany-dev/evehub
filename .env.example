# ---------------------------------------------------------------------------
# Eve Hub — copie para .env e preencha. Nunca comite o .env.
# ---------------------------------------------------------------------------

# Senhas do Postgres e do Redis do docker-compose.yml. Obrigatorias: sem
# elas o `docker compose` nem sobe. Use valores sem simbolos (entram direto
# nas URLs): openssl rand -hex 32
#   POSTGRES_PASSWORD      superusuario `eve`: so migrations e o db-init usam
#   POSTGRES_APP_PASSWORD  papel `evehub_app`, com que web e worker conectam
#                          em producao (le e grava linhas, nao muda o schema)
#   REDIS_PASSWORD         o Redis exige senha
# Num volume ja existente, o Postgres guarda a senha do `eve` de quando foi
# criado: trocar aqui tambem exige um ALTER USER (veja o README).
POSTGRES_PASSWORD=""
POSTGRES_APP_PASSWORD=""
REDIS_PASSWORD=""

# Banco e Redis vistos da sua maquina (pnpm dev, prisma CLI). Repita aqui as
# senhas acima. Em producao o docker-compose.yml monta as URLs dos containers
# sozinho a partir das senhas, e estas duas linhas nao sao usadas.
DATABASE_URL="postgresql://eve:SUA_POSTGRES_PASSWORD@localhost:5432/evehub?schema=public"

# Redis (fila BullMQ, pub/sub do SSE, rate limit de login)
REDIS_URL="redis://:SUA_REDIS_PASSWORD@localhost:6379"

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET=""
# AUTH_URL fica VAZIO em dev de proposito: com trustHost ligado, o Auth.js usa o
# host de cada requisicao. Fixar em localhost quebra o acesso pelo IP da rede
# (celular) e pelo IP da Tailscale. Em PRODUCAO e obrigatorio (o app nao sobe
# sem): o dominio real, https, o mesmo de PUBLIC_BASE_URL.
# AUTH_URL="https://hub.evecompany.com.br"

# Google OAuth (console.cloud.google.com > Credentials > OAuth client ID > Web)
# Redirect URI autorizado: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Só e-mails deste dominio entram pelo Google. Vazio = qualquer dominio, o que so
# vale em dev: em producao o app nao sobe sem isto.
ALLOWED_EMAIL_DOMAIN="evecompany.com.br"

# Chave de cifra das credenciais de connector (AES-256-GCM).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=""
CREDENTIALS_KEY_VERSION="1"
# Durante rotacao de chave, mantenha a anterior aqui para ainda conseguir decifrar:
# CREDENTIALS_KEY_V1="<chave antiga em base64>"

# Seed do primeiro owner. O seed recusa a senha de exemplo abaixo e qualquer
# senha com menos de 12 caracteres; vazio = o owner entra so pelo Google.
SEED_OWNER_EMAIL="marketing@evecompany.com.br"
SEED_OWNER_PASSWORD="troque-esta-senha"
SEED_WORKSPACE_NAME="EveCompany"

# Worker
SYNC_INTERVAL_MS="300000"
SNAPSHOT_RETENTION_DAYS="30"

# Diretorio compartilhado de uploads — so importa em Docker (docker-compose.yml
# ja define isto para web e worker, apontando pro mesmo volume). Vazio em dev
# nativo: web e worker ja compartilham o disco, cada um usa seu proprio default
# (apps/web/.uploads). Precisa ficar FORA de apps/web/public: o Next serve
# public/ com o Content-Type derivado da extensao, e um .svg enviado por um
# usuario viraria um documento executando no proprio dominio do app. Uma
# instalacao antiga com arquivos em apps/web/public/uploads e movida sozinha
# para apps/web/.uploads no primeiro upload/leitura depois de atualizar.
UPLOADS_DIR=""
# Quantos dias a midia local de um post JA PUBLICADO sobrevive antes do worker
# apagar (o Meta ja baixou e hospeda a propria copia assim que publica —
# isto so mantem a miniatura do calendario funcionando por um tempo depois).
MEDIA_RETENTION_DAYS="7"

# Widget de chat com o Claude (console.anthropic.com). Opcional: sem isto, o
# widget so avisa que a chave nao esta configurada, o resto do app funciona normal.
ANTHROPIC_API_KEY=""

# Endereco publico do app, ex: https://hub.evecompany.com.br. Obrigatorio em
# PRODUCAO (o app nao sobe sem, e precisa ser https): o Meta baixa a imagem do
# post por esta URL, e o redirect do Google Agenda volta para ela.
# Vazio so em dev = usa a origem da propria requisicao (em dev isso vira
# http://localhost:3000, que o Meta nao alcanca).
PUBLIC_BASE_URL=""

# E-mail de saida (hoje so os relatos de bug, que vao para jose@evecompany.com.br).
# Google Workspace: gere uma "senha de app" na conta que envia (precisa da
# verificacao em 2 etapas ligada) e troque o @ do login por %40:
#   SMTP_URL="smtps://marketing%40evecompany.com.br:SENHA_DE_APP@smtp.gmail.com:465"
# Vazio = sem e-mail; o relato continua chegando no sino e no registro de atividades.
SMTP_URL=""
MAIL_FROM=""
