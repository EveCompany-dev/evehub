# syntax=docker/dockerfile:1

# Build context is the repo root, so the whole workspace is available.
FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/core/package.json packages/core/
COPY packages/connector-sdk/package.json packages/connector-sdk/
COPY packages/ui/package.json packages/ui/
COPY packages/connectors/calculator/package.json packages/connectors/calculator/
COPY packages/connectors/calendar/package.json packages/connectors/calendar/
COPY packages/connectors/chat/package.json packages/connectors/chat/
COPY packages/connectors/demo/package.json packages/connectors/demo/
COPY packages/connectors/google-ads/package.json packages/connectors/google-ads/
COPY packages/connectors/google-calendar/package.json packages/connectors/google-calendar/
COPY packages/connectors/meta/package.json packages/connectors/meta/
COPY packages/connectors/notes/package.json packages/connectors/notes/
COPY packages/connectors/notion/package.json packages/connectors/notion/
COPY packages/connectors/overview/package.json packages/connectors/overview/
COPY packages/connectors/timer/package.json packages/connectors/timer/
COPY packages/connectors/todo/package.json packages/connectors/todo/
RUN pnpm install --frozen-lockfile

FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/web/node_modules ./apps/web/node_modules
COPY --from=deps /app/packages ./packages
COPY . .
# The Prisma client is generated, never committed.
RUN pnpm db:generate && pnpm --filter @eve/web build

FROM base AS runtime
ENV NODE_ENV=production
COPY --from=build /app ./
# The code stays root-owned (read-only to the app); `node` only gets the two
# places it writes: Next's cache and the uploads volume. A fresh volume copies
# this directory's ownership; one created before is fixed by the
# `uploads-perms` service in docker-compose.yml.
RUN mkdir -p /data/uploads apps/web/.next/cache \
  && chown -R node:node /data/uploads apps/web/.next/cache
USER node
WORKDIR /app/apps/web
EXPOSE 3000
# Node directly, not through pnpm: pnpm does not reliably pass SIGTERM on, so
# a `docker compose stop` would wait out the grace period and SIGKILL.
CMD ["node", "node_modules/next/dist/bin/next", "start", "--port", "3000"]
