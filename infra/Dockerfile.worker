# syntax=docker/dockerfile:1

FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/core/package.json packages/core/
COPY packages/connector-sdk/package.json packages/connector-sdk/
COPY packages/ui/package.json packages/ui/
COPY packages/connectors/calculator/package.json packages/connectors/calculator/
COPY packages/connectors/calendar/package.json packages/connectors/calendar/
COPY packages/connectors/chat/package.json packages/connectors/chat/
COPY packages/connectors/demo/package.json packages/connectors/demo/
COPY packages/connectors/meta/package.json packages/connectors/meta/
COPY packages/connectors/notes/package.json packages/connectors/notes/
COPY packages/connectors/notion/package.json packages/connectors/notion/
RUN pnpm install --frozen-lockfile

FROM base AS runtime
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# The worker runs TypeScript directly through tsx; no bundling step to keep in
# sync with the web app's.
RUN pnpm db:generate
CMD ["pnpm", "--filter", "@eve/worker", "start"]
