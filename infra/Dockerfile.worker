# syntax=docker/dockerfile:1

FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/core/package.json packages/core/
COPY packages/connector-sdk/package.json packages/connector-sdk/
COPY packages/ui/package.json packages/ui/
COPY packages/connectors/calculator/package.json packages/connectors/calculator/
COPY packages/connectors/calendar/package.json packages/connectors/calendar/
COPY packages/connectors/chat/package.json packages/connectors/chat/
COPY packages/connectors/demo/package.json packages/connectors/demo/
COPY packages/connectors/google-ads/package.json packages/connectors/google-ads/
COPY packages/connectors/meta/package.json packages/connectors/meta/
COPY packages/connectors/notes/package.json packages/connectors/notes/
COPY packages/connectors/notion/package.json packages/connectors/notion/
COPY packages/connectors/overview/package.json packages/connectors/overview/
COPY packages/connectors/timer/package.json packages/connectors/timer/
RUN pnpm install --frozen-lockfile

FROM base AS runtime
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
# pnpm hoists shared deps into the root node_modules above, but each workspace
# package still gets its own node_modules (mostly symlinks back into the
# root). Copying only the root left @eve/worker's own package (tsx, ioredis,
# bullmq...) and every @eve/* package unresolvable — ERR_MODULE_NOT_FOUND at
# boot. Dockerfile.web already does this for apps/web; the worker never had
# the equivalent line.
COPY --from=deps /app/apps/worker/node_modules ./apps/worker/node_modules
COPY --from=deps /app/packages ./packages
COPY . .
# The worker runs TypeScript directly through tsx; no bundling step to keep in
# sync with the web app's.
RUN pnpm db:generate
CMD ["pnpm", "--filter", "@eve/worker", "start"]
