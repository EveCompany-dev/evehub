// Eve Hub — schema v0.0.3
// Correcoes aplicadas sobre o esboco da v0.0.2 estao documentadas em
// eve-hub-v0.0.3-escopo.md, secao 2.

generator client {
  provider = "prisma-client-js"
  output   = "../../packages/core/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Prisma 7: a connection string vive em prisma.config.ts (CLI/migrate) e no
// driver adapter passado ao PrismaClient (runtime). Nao existe mais url aqui.

enum ConnectorStatus {
  ok
  syncing
  error
  disabled
}

enum PostPlatform {
  instagram
  facebook
}

enum PostType {
  feed
  story
  /// So Instagram, e so com video: o container usa media_type REELS.
  reel
}

enum PostStatus {
  draft
  scheduled
  publishing
  published
  failed
}

enum ClientSource {
  local
  notion
}

enum NotificationType {
  jobCollaboratorAdded
  jobTaskDone
  teamMessageMention
  markedImportant
  /// Um post agendado nao foi publicado. Criado pelo worker, nao por uma
  /// acao de usuario — e o unico aviso de que algo falhou, ja que ninguem
  /// fica olhando o calendario na hora marcada.
  scheduledPostFailed
}

enum FinancialEntryType {
  income
  expense
}

// ---------------------------------------------------------------------------
// Workspace / usuarios
// ---------------------------------------------------------------------------

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  /// Token do endpoint de ingestao de automacoes (n8n etc.) — null ate o
  /// primeiro "gerar link" na aba Automacoes. Mesmo padrao do
  /// DataTable.webhookToken: o token EH a credencial, sem usuario/senha.
  automationWebhookToken String? @unique

  users              User[]
  connectorInstances ConnectorInstance[]
  editLogs           EditLog[]
  automationLogs     AutomationLog[]
  clients            Client[]
  scheduledPosts     ScheduledPost[]
  dataTables         DataTable[]
  jobColumns         JobColumn[]
  jobs               Job[]
  notifications      Notification[]
  financialEntries   FinancialEntry[]
  teamMessages       TeamMessage[]
  roles              Role[]
}

model User {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  /// null = usuario so entra por Google (nunca teve senha definida)
  passwordHash String?

  /// Unica distincao de permissao do produto: quem pode gerenciar credenciais
  /// de connector. Todo o resto e livre para qualquer usuario autenticado.
  isOwner Boolean @default(false)

  /// Tag de equipe: quem ve e mexe na aba de agendamento. Owner ve tambem,
  /// independente desta flag. Atalho legado que sobrevive ao lado do sistema
  /// de Role — um Role pode conceder o mesmo acesso (e mais) de forma
  /// explicita, mas remover essa flag nao tira o que um Role ja concedeu.
  isSocialMedia Boolean @default(false)

  /// Cargo opcional que concede abas alem do conjunto base (ver DEFAULT_TABS
  /// em lib/permissions.ts). Null = so o conjunto base (+ isSocialMedia, se
  /// marcado). Owner ignora isto por completo — sempre ve tudo.
  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  /// Base do delta do feed diario de IA (v0.0.6). Atualizado a cada sessao.
  lastSeenAt DateTime?

  /// Acesso revogado. Nao apagamos usuario: EditLog aponta para ele e a trilha
  /// de auditoria tem que sobreviver a saida de alguem da agencia.
  disabledAt DateTime?

  /// Layout do grid + config por widget. Ver packages/core/src/dashboard-config.ts
  dashboardConfig Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts          Account[]
  sessions          Session[]
  editLogs          EditLog[]
  scheduledPosts    ScheduledPost[]
  createdJobs       Job[]                @relation("JobCreator")
  jobCollaborations JobCollaborator[]
  assignedTasks     JobTask[]
  jobComments       JobComment[]
  timeEntries       TimeEntry[]
  notifications     Notification[]
  attachments       Attachment[]
  financialEntries  FinancialEntry[]
  teamMessages      TeamMessage[]
  teamMentions      TeamMessageMention[]

  @@index([workspaceId])
}

// --- Tabelas exigidas pelo @auth/prisma-adapter -----------------------------
// Nomes de coluna em snake_case sao requisito do Auth.js, nao estilo do projeto.
// `Session` fica ociosa enquanto a estrategia for JWT (obrigatoria para o
// provider de credenciais), mas e mantida para nao travar a troca depois.

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Connectors
// ---------------------------------------------------------------------------

model ConnectorInstance {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Casa com EveConnector.id do registry: 'demo', 'notion', 'meta-ads'...
  connectorId String
  label       String

  /// Validado contra o configSchema (Zod) do proprio connector.
  config Json @default("{}")

  /// AES-256-GCM. null enquanto o connector nao exige credencial.
  credentialsEnc        Bytes?
  /// Permite rotacionar a chave sem decifrar tudo de uma vez.
  credentialsKeyVersion Int    @default(1)

  status        ConnectorStatus @default(ok)
  /// Ultimo erro legivel, exibido direto no cabecalho do widget.
  statusMessage String?

  lastSyncedAt DateTime?

  /// Leitura O(1) do snapshot corrente, em vez de `order by syncedAt desc limit 1`.
  latestSnapshotId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  snapshots      SyncSnapshot[]
  records        SyncRecord[]
  editLogs       EditLog[]
  scheduledPosts ScheduledPost[]

  @@index([workspaceId, connectorId])
}

/// Fotografia bruta da resposta da fonte. Serve para debug e para o delta do
/// feed diario. Nao e a fonte da verdade para escrita — isso e o SyncRecord.
model SyncSnapshot {
  id                  String            @id @default(cuid())
  connectorInstanceId String
  connectorInstance   ConnectorInstance @relation(fields: [connectorInstanceId], references: [id], onDelete: Cascade)

  data     Json
  syncedAt DateTime @default(now())

  @@index([connectorInstanceId, syncedAt])
}

/// Uma linha por objeto remoto. `remoteVersion` (last_edited_time & cia) e o
/// que torna a trava otimista possivel por registro, e nao por tabela inteira.
model SyncRecord {
  id                  String            @id @default(cuid())
  connectorInstanceId String
  connectorInstance   ConnectorInstance @relation(fields: [connectorInstanceId], references: [id], onDelete: Cascade)

  remoteId      String
  remoteVersion String
  data          Json
  syncedAt      DateTime @default(now())

  @@unique([connectorInstanceId, remoteId])
}

model EditLog {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  connectorInstanceId String
  connectorInstance   ConnectorInstance @relation(fields: [connectorInstanceId], references: [id], onDelete: Cascade)

  /// Anulavel de proposito: a conta pode ser apagada depois da edicao, e a
  /// trilha tem que sobreviver a isso. Ver `userLabel`.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Nome (ou e-mail) do autor, gravado no momento em que a conta dele e
  /// apagada. Enquanto a conta existe isto fica null e o nome sai de `user`;
  /// depois, e a unica coisa que impede a entrada de virar "autor
  /// desconhecido".
  userLabel String?

  remoteId  String
  fieldPath String
  oldValue  Json
  newValue  Json

  /// Marca que esta entrada ja foi desfeita. O undo em si grava uma entrada
  /// nova (a edicao reversa), preservando a trilha completa.
  rolledBackAt DateTime?
  /// Aponta para a entrada de undo que reverteu esta.
  rolledBackBy String?
  /// Preenchido quando ESTA entrada e o desfazer de outra.
  /// Sem isso o undo vira loop: ele grava uma edicao reversa, que aparece como
  /// "desfazivel", e o usuario fica alternando entre os dois valores para sempre.
  undoOf       String?

  createdAt DateTime @default(now())

  @@index([connectorInstanceId, createdAt])
  @@index([userId])
}

model AutomationLog {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  source  String
  event   String
  payload Json
  ok      Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
}

// ---------------------------------------------------------------------------
// Agenda / agendamento de posts
// ---------------------------------------------------------------------------

/// Lista local de clientes, independente do Notion. O filtro da agenda
/// combina isto com registros vindos de Workspace.clientSourceInstanceId.
model Client {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name  String
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheduledPosts   ScheduledPost[]
  jobs             Job[]
  financialEntries FinancialEntry[]

  @@index([workspaceId])
}

model ScheduledPost {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// A instancia do connector Meta (Pagina/conta IG) que publica este post.
  connectorInstanceId String
  connectorInstance   ConnectorInstance @relation(fields: [connectorInstanceId], references: [id], onDelete: Cascade)

  clientSource   ClientSource
  /// Preenchido quando clientSource = local.
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// Preenchido quando clientSource = notion (o id da pagina no Notion).
  clientRemoteId String?
  /// Nome de exibicao, desnormalizado — funciona igual para as duas origens
  /// sem precisar de join nem de reler o Notion so pra mostrar o filtro.
  clientLabel    String

  platform PostPlatform
  /// feed = post normal (padrao); story = story de 24h. Story no Facebook nao
  /// tem agendamento nativo da Meta como o feed tem — o worker publica na
  /// hora marcada igual ja faz para o Instagram.
  postType PostType     @default(feed)
  caption  String
  mediaUrl String

  scheduledFor  DateTime
  status        PostStatus @default(scheduled)
  statusMessage String?

  /// Instagram: id do container criado no passo 1 (antes do media_publish).
  metaCreationId String?
  /// Id do post/media ja publicado no Meta, quando existe.
  metaPostId     String?

  createdBy     String
  createdByUser User   @relation(fields: [createdBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, scheduledFor])
  @@index([status, scheduledFor])
}

// ---------------------------------------------------------------------------
// Tabelas locais (estilo Notion, sem nenhuma fonte externa)
// ---------------------------------------------------------------------------

/// Colunas ficam em `columns` (Json), validadas contra dataColumnSchema em
/// packages/core/src/data-tables.ts. `key` de cada coluna e imutavel depois de
/// criada — so `label`/`options` sao editaveis — para nao orfanar dado
/// existente ao renomear.
model DataTable {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name    String
  columns Json

  /// Token opaco: POST /api/webhooks/tables/{token} atualiza esta tabela.
  /// Null = automacao desligada. O token EH a credencial — sem header extra.
  webhookToken     String? @unique
  /// Chave de coluna usada para casar uma linha existente num POST recebido.
  /// Null = todo POST cria uma linha nova.
  webhookKeyColumn String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rows DataTableRow[]

  @@index([workspaceId])
}

model DataTableRow {
  id      String    @id @default(cuid())
  tableId String
  table   DataTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  data Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tableId])
}

// ---------------------------------------------------------------------------
// Jobs (quadro kanban compartilhado do workspace) — mLabs clone, Fase 1.
//
// As colunas sao so organizacao: mover um job para "Aprovacao Interna" nao
// aciona nenhuma regra, e so onde quem aprova costuma olhar. Notificacoes,
// cronometro por tarefa e anexos ficam para as proximas fases — o schema
// deixa espaco (novas tabelas relacionadas a JobTask), sem redesenhar nada.
// ---------------------------------------------------------------------------

model JobColumn {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name     String
  position Int

  jobs Job[]

  createdAt DateTime @default(now())

  /// Fecha a corrida do lazy-seed: duas requisicoes concorrentes que veem a
  /// coluna vazia ao mesmo tempo nao criam mais os 4 padroes em dobro.
  @@unique([workspaceId, name])
  @@index([workspaceId, position])
}

model Job {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  columnId String
  column   JobColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  position Int

  title       String
  description String?
  dueDate     DateTime?

  /// Sobe para true->false apenas manualmente. A transicao false->true e o
  /// gatilho de notificacao (in-app + push) para os colaboradores do job.
  important Boolean @default(false)

  /// Cliente local vinculado (via o mesmo Client usado pela agenda) —
  /// opcional, preenchido quando alguem confirma o match de nome na
  /// descricao ou vincula manualmente.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  createdBy     String
  createdByUser User   @relation("JobCreator", fields: [createdBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collaborators    JobCollaborator[]
  tasks            JobTask[]
  comments         JobComment[]
  timeEntries      TimeEntry[]
  notifications    Notification[]
  financialEntries FinancialEntry[]

  @@index([workspaceId, columnId, position])
}

model JobCollaborator {
  id     String @id @default(cuid())
  jobId  String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  @@unique([jobId, userId])
  @@index([userId])
}

model JobTask {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  title       String
  description String?
  dueDate     DateTime?

  assigneeId String?
  assignee   User?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  /// Booleano simples de proposito: a fase da tarefa mora na coluna do Job,
  /// isto e so "feita ou nao".
  done Boolean @default(false)

  /// Mesma semantica do Job.important — a transicao false->true notifica o
  /// assignee (in-app + push), nao o job inteiro.
  important Boolean @default(false)
  position  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeEntries TimeEntry[]
  attachments Attachment[]

  @@index([jobId, position])
}

model JobComment {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  body String

  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
}

/// Um cronometro por vez por pessoa: iniciar um novo para uma tarefa/job
/// encerra automaticamente qualquer entrada ainda aberta (endedAt null) da
/// mesma pessoa (ver POST /api/jobs/[id]/time-entries). taskId nulo = tempo
/// lancado no job como um todo, nao numa tarefa especifica.
model TimeEntry {
  id     String   @id @default(cuid())
  jobId  String
  job    Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  taskId String?
  task   JobTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([taskId])
  @@index([userId, endedAt])
}

/// In-app notifications — a side effect of other actions (never created
/// directly by a client request). `jobId` nullable for future notification
/// types that aren't job-related; every type that exists today has one.
model Notification {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  message String

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

/// A finished-work file dropped onto a task. Stored on local disk (see
/// lib/uploads.ts); `url` is what the browser fetches, `filename` is the
/// original name kept only for display.
model Attachment {
  id     String  @id @default(cuid())
  taskId String
  task   JobTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  uploadedBy String
  uploader   User   @relation(fields: [uploadedBy], references: [id])

  filename String
  url      String
  size     Int

  createdAt DateTime @default(now())

  @@index([taskId])
}

// ---------------------------------------------------------------------------
// Financeiro
// ---------------------------------------------------------------------------

/// Lancamento manual de entrada/saida — o modulo Financeiro comeca como um
/// livro-caixa simples, sem integracao com banco/gateway. `amountCents`
/// evita erro de arredondamento de ponto flutuante em valores monetarios.
model FinancialEntry {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  type        FinancialEntryType
  description String
  amountCents Int
  date        DateTime

  /// Vinculos opcionais — permitem ver o lancamento a partir do cliente/job
  /// sem exigi-los (nem todo gasto tem um job ou cliente associado).
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  jobId    String?
  job      Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  createdBy     String
  createdByUser User   @relation(fields: [createdBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, date])
}

// ---------------------------------------------------------------------------
// Chat da equipe
// ---------------------------------------------------------------------------

/// Chat unico do workspace inteiro (nao por job) — o mesmo grupo ve tudo,
/// sem canais/DMs por enquanto. `body` guarda o texto ja com "@Nome" literal
/// escrito nele; `mentions` e a lista estruturada usada para notificar e
/// para o realce visual, preenchida pelo composer (que ja sabe exatamente
/// quem foi selecionado no picker) em vez de re-parsear o texto no servidor.
model TeamMessage {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  body String

  createdAt DateTime @default(now())

  attachments TeamMessageAttachment[]
  mentions    TeamMessageMention[]

  @@index([workspaceId, createdAt])
}

/// Mesmo padrao do Attachment de JobTask, so que preso a uma mensagem de
/// chat em vez de uma tarefa — modelo separado para nao forcar um FK opcional
/// duplo (taskId/messageId) num unico Attachment.
model TeamMessageAttachment {
  id        String      @id @default(cuid())
  messageId String
  message   TeamMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  filename String
  url      String
  size     Int

  createdAt DateTime @default(now())

  @@index([messageId])
}

model TeamMessageMention {
  id        String      @id @default(cuid())
  messageId String
  message   TeamMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Cargos (roles) — visibilidade de aba por usuario nao-owner
// ---------------------------------------------------------------------------

/// Um cargo definido pelo owner, com o conjunto de abas extras que ele
/// enxerga (alem do conjunto base que todo usuario autenticado ja tem — ver
/// DEFAULT_TABS em lib/permissions.ts). Owner sempre enxerga tudo,
/// independente de cargo. `isSocialMedia` continua existindo em paralelo
/// como um atalho legado que so libera 'scheduling' — um cargo pode fazer o
/// mesmo (e mais) de forma explicita.
model Role {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name String
  /// Array de strings (chaves de TAB_KEYS), ex.: ["scheduling","financial"].
  tabs Json   @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@unique([workspaceId, name])
}
